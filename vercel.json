{
  "functions": {
    "api/build-mor.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/water-reminder",
      "schedule": "0 12 7 * *"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pro",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/golf",
      "destination": "/pool/golf",
      "statusCode": 301
    },
    {
      "source": "/golf/picks",
      "destination": "/pool/golf/picks",
      "statusCode": 301
    },
    {
      "source": "/football",
      "destination": "/pool/football",
      "statusCode": 301
    },
    {
      "source": "/football/picks",
      "destination": "/pool/football/picks",
      "statusCode": 301
    },
    {
      "source": "/football/commish",
      "destination": "/pool/commish",
      "statusCode": 301
    },
    {
      "source": "/ryc/dashboard",
      "destination": "/ryc/command",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/groundwork/index.html",
      "has": [
        {
          "type": "host",
          "value": "groundwork.civicscope.io"
        }
      ]
    },
    {
      "source": "/editions/:n",
      "destination": "/groundwork/edition.html?n=:n",
      "has": [
        {
          "type": "host",
          "value": "groundwork.civicscope.io"
        }
      ]
    },
    {
      "source": "/unsubscribe",
      "destination": "/groundwork/unsubscribe.html",
      "has": [
        {
          "type": "host",
          "value": "groundwork.civicscope.io"
        }
      ]
    },
    {
      "source": "/invoices",
      "destination": "/ryc-invoices/index.html"
    },
    {
      "source": "/invoices/:path*",
      "destination": "/ryc-invoices/index.html"
    },
    {
      "source": "/ryc/invoices",
      "destination": "/ryc-invoices/index.html"
    },
    {
      "source": "/ryc/invoices/:path*",
      "destination": "/ryc-invoices/index.html"
    },
    {
      "source": "/try/:slug",
      "destination": "/api/try?slug=:slug"
    },
    {
      "source": "/unsubscribe",
      "destination": "/api/unsubscribe"
    },
    {
      "source": "/admin",
      "destination": "/civicscope-admin/index.html"
    },
    {
      "source": "/qa",
      "destination": "/civicscope-qa/index.html"
    },
    {
      "source": "/schools",
      "destination": "/civicscope-schools/index.html"
    },
    {
      "source": "/infrastructure",
      "destination": "/civicscope-infrastructure/index.html"
    },
    {
      "source": "/for-government",
      "destination": "/for-government/index.html"
    },
    {
      "source": "/for-schools",
      "destination": "/for-schools/index.html"
    },
    {
      "source": "/for-infrastructure",
      "destination": "/for-infrastructure/index.html"
    },
    {
      "source": "/desk",
      "destination": "/ryc-estimate/index.html"
    },
    {
      "source": "/desk/:path*",
      "destination": "/ryc-estimate/index.html"
    },
    {
