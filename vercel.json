    {
      "source": "/pool",
      "destination": "/pool/index.html"
    },
    {
      "source": "/pool/golf",
      "destination": "/pool/golf.html"
    },
    {
      "source": "/pool/golf/picks",
      "destination": "/pool/golf-picks.html"
    },
    {
      "source": "/pool/football",
      "destination": "/pool/football.html"
    },
    {
      "source": "/pool/football/picks",
      "destination": "/pool/football-picks.html"
    },
    {
